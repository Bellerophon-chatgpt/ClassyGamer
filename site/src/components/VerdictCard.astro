---
import Stars from './Stars.astro';

interface Props {
  label: string;
  stars: number;
  text: string;
}
const { label, stars, text } = Astro.props;
---

<aside class="relative overflow-hidden rounded-card bg-navy-900 p-7 text-cream">
  <div class="pointer-events-none absolute -top-24 -right-20 size-64 rounded-full bg-violet/30 blur-3xl" aria-hidden="true"></div>
  <div class="relative">
    <p class="eyebrow text-violet-100/70">Ons verdict</p>
    <p class="mt-3 font-serif text-[28px] leading-none font-bold tracking-tight">{label}</p>
    <Stars value={stars} class="mt-3 text-xl text-violet-100" />
    <p class="mt-5 text-[15px] leading-relaxed text-cream/80">{text}</p>
    <a
      href="#vergelijkbaar"
      class="mt-6 inline-flex rounded-chip bg-violet px-4 py-2.5 text-sm font-semibold text-surface transition-colors hover:bg-violet-600"
    >
      Vergelijkbare games →
    </a>
  </div>
</aside>
