---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-grid size-9 place-items-center rounded-full border-[1.5px] border-violet font-serif text-[12px] font-bold tracking-tight text-violet',
    className,
  ]}
  aria-hidden="true">TCG</span
>
