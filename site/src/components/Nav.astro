---
import Monogram from './Monogram.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/#reviews', label: 'Reviews' },
  { href: '/over', label: 'Over' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/#reviews' ? path.startsWith('/reviews') : href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-20 border-b bg-cream/90 backdrop-blur-md">
  <div class="mx-auto flex h-[68px] max-w-content items-center gap-3 px-4 sm:gap-6 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="The Classy Gamer — naar home">
      <span class="flex flex-col border-[1.5px] border-ink px-2 py-1 text-center font-serif leading-[0.9] font-extrabold">
        <span class="text-[8px] tracking-[0.25em]">THE</span>
        <span class="text-[13px] tracking-wide">CLASSY</span>
        <span class="text-[13px] tracking-wide">GAMER</span>
      </span>
      <span class="hidden sm:contents"><Monogram /></span>
    </a>

    <nav class="ml-auto flex items-center gap-0.5 text-[14px] sm:gap-2 sm:text-[15px]" aria-label="Hoofdnavigatie">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-chip px-2 py-1.5 sm:px-2.5 transition-colors hover:text-violet-600 max-sm:[&:first-child]:hidden',
              isActive(l.href) ? 'font-semibold text-violet-600' : 'font-medium text-secondary',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#nieuwsbrief"
      class="rounded-full bg-violet px-3.5 py-2 text-[13px] sm:px-4 sm:text-sm font-semibold whitespace-nowrap text-surface transition-colors hover:bg-violet-600"
    >
      Nieuwsbrief
    </a>
  </div>
</header>
