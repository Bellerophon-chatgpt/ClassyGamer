---
interface Props {
  yes: string[];
  no: string[];
}
const { yes, no } = Astro.props;
const columns = [
  { heading: 'Dit is jouw game als…', items: yes, icon: '✓', tone: 'text-success' },
  { heading: 'Sla ’m over als…', items: no, icon: '✕', tone: 'text-danger' },
];
---

<section class="grid gap-5 md:grid-cols-2">
  {
    columns.map((col) => (
      <div class="rounded-card border bg-surface p-7">
        <h2 class="text-xl font-semibold">{col.heading}</h2>
        <ul class="mt-4 space-y-3">
          {col.items.map((item) => (
            <li class="flex gap-3 text-[15px] leading-relaxed">
              <span class:list={['shrink-0 font-bold', col.tone]} aria-hidden="true">
                {col.icon}
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
