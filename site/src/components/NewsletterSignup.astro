        <input class="cg-newsletter-input" placeholder="jouw@email.nl" type="email" disabled />
        <button class="cg-newsletter-btn" type="button" disabled>Inschrijven</button>
      </form>
    </div>
    <p class="cg-newsletter-note">Wekelijks · uitschrijven kan altijd.</p>
  </div>
</section>
