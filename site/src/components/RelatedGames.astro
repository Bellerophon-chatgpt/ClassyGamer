---
import ArtPlaceholder from './ArtPlaceholder.astro';
import VerdictPill from './VerdictPill.astro';

interface Props {
  games: { title: string; match: number; verdict: string; note: string }[];
}
const { games } = Astro.props;
---

<section id="vergelijkbaar" class="scroll-mt-24">
  <h2 class="text-2xl font-semibold">Ook je tijd waard</h2>
  <p class="mt-1 text-sm text-secondary">Vergelijkbare games, gekozen door The Curator.</p>
  <ul class="mt-5 grid gap-4 md:grid-cols-3">
    {
      games.map((g) => (
        <li class="flex flex-col overflow-hidden rounded-card border bg-surface">
          <ArtPlaceholder title={g.title} size="thumb" class="rounded-none" />
          <div class="flex flex-1 flex-col gap-3 p-5">
            <div class="flex items-center justify-between gap-2">
              <VerdictPill label={g.verdict} tone="soft" class="px-2.5 py-1 text-[10px]" />
              <span class="text-sm font-semibold text-success tabular-nums">{g.match}% match</span>
            </div>
            <h3 class="text-lg leading-tight font-semibold">{g.title}</h3>
            <p class="text-sm leading-relaxed text-secondary">{g.note}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
