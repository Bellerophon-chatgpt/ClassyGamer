---
// Nette placeholder zolang er geen art is: navy gradient met de gametitel.
interface Props {
  title: string;
  image?: string;
  size?: 'hero' | 'thumb';
  class?: string;
}
const { title, image, size = 'hero', class: className = '' } = Astro.props;
---

{
  image ? (
    <img src={image} alt="" class:list={['w-full rounded-card object-cover', className]} />
  ) : (
    <div
      class:list={[
        'relative isolate overflow-hidden rounded-card bg-navy-900 text-cream',
        size === 'hero' ? 'aspect-[4/3] sm:aspect-[21/9]' : 'aspect-[16/7]',
        className,
      ]}
      aria-hidden="true"
    >
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(120%_90%_at_85%_10%,color-mix(in_oklab,var(--color-violet)_45%,transparent),transparent_60%),linear-gradient(160deg,var(--color-navy-800),var(--color-navy-900)_70%)]" />
      <div class="absolute inset-0 -z-10 opacity-[0.07] [background:repeating-linear-gradient(135deg,var(--color-cream)_0_1px,transparent_1px_14px)]" />
      <span
        class:list={[
          'absolute font-serif leading-[0.95] font-semibold text-cream/90',
          size === 'hero' ? 'bottom-6 left-6 max-w-[80%] text-3xl sm:bottom-8 sm:left-8 sm:text-5xl' : 'bottom-3 left-4 max-w-[85%] text-lg',
        ]}
      >
        {title}
      </span>
      {size === 'hero' && <span class="eyebrow absolute top-5 right-6 text-cream/40">Artwork volgt</span>}
    </div>
  )
}
