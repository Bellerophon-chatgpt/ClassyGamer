---
interface Props {
  tiers: { price: string; label: string; highlight: boolean }[];
}
const { tiers } = Astro.props;
---

<section>
  <h2 class="text-2xl font-semibold">Wat is ’ie je waard?</h2>
  <p class="mt-1 text-sm text-secondary">Bij welke prijs je instapt.</p>
  <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      tiers.map((tier) => (
        <li
          class:list={[
            'rounded-card p-5',
            tier.highlight ? 'bg-violet text-surface shadow-[0_18px_40px_-20px_var(--color-violet)]' : 'border bg-surface',
          ]}
        >
          <p class="font-serif text-2xl font-bold tracking-tight">{tier.price}</p>
          <p class:list={['mt-1.5 text-sm leading-snug', tier.highlight ? 'text-violet-100' : 'text-secondary']}>{tier.label}</p>
        </li>
      ))
    }
  </ol>
</section>
