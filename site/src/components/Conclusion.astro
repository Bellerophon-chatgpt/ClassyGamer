---
import VerdictPill from './VerdictPill.astro';

interface Props {
  label: string;
  text: string;
}
const { label, text } = Astro.props;
---

<section class="rounded-card border border-violet/25 bg-violet-100 p-8 sm:p-10">
  <p class="eyebrow text-violet-600">Conclusie</p>
  <p class="mt-3 max-w-3xl font-serif text-[22px] leading-snug sm:text-[26px]">{text}</p>
  <VerdictPill label={label} class="mt-6" />
</section>
