---
import Monogram from './Monogram.astro';
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-navy-900 text-cream">
  <div class="mx-auto flex max-w-content flex-col gap-10 px-4 py-14 sm:px-6 md:flex-row md:items-end md:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <Monogram />
        <span class="font-serif text-xl font-semibold">The Classy Gamer</span>
      </div>
      <p class="mt-3 font-script text-[28px] leading-none text-violet-100">Better games. More time.</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60">
        Onafhankelijke reviews door The Curator. Nooit gesponsord, altijd met de vraag: is dit je tijd waard?
      </p>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-cream/70" aria-label="Footer">
      <a href="/" class="hover:text-cream">Home</a>
      <a href="/over" class="hover:text-cream">Over The Curator</a>
      <a href="/statuut" class="hover:text-cream">Redactiestatuut</a>
    </nav>
  </div>
  <div class="border-t border-cream/10">
    <p class="mx-auto max-w-content px-4 py-5 text-xs text-cream/40 sm:px-6">© {year} The Classy Gamer</p>
  </div>
</footer>
