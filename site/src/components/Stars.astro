---
// Pure CSS: een rij lege sterren met daarover een gevulde rij, afgekapt op stars/5.
interface Props {
  value: number;
  class?: string;
}
const { value, class: className = '' } = Astro.props;
const label = `${value.toLocaleString('nl-NL')} van 5 sterren`;
---

<span class:list={['relative inline-block leading-none tracking-[0.12em]', className]} role="img" aria-label={label}>
  <span class="opacity-25" aria-hidden="true">★★★★★</span>
  <span class="absolute inset-y-0 left-0 overflow-hidden whitespace-nowrap" style={`width:${(value / 5) * 100}%`} aria-hidden="true"
    >★★★★★</span
  >
</span>
