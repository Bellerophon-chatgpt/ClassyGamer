---
interface Props {
  chips: {
    speelduur: string;
    genre: string;
    spelers: string;
    moeilijkheid: string;
    platforms: string[];
    prijs: string;
  };
}
const { chips } = Astro.props;
const items = [
  ['Speelduur', chips.speelduur],
  ['Genre', chips.genre],
  ['Spelers', chips.spelers],
  ['Moeilijkheid', chips.moeilijkheid],
  ['Platforms', chips.platforms.join(' · ')],
  ['Prijs', chips.prijs],
];
---

<dl class="flex flex-wrap gap-2.5">
  {
    items.map(([label, value]) => (
      <div class="rounded-chip border bg-surface px-3.5 py-2.5">
        <dt class="eyebrow text-[10px] text-secondary">{label}</dt>
        <dd class="mt-0.5 text-[15px] font-semibold">{value}</dd>
      </div>
    ))
  }
</dl>
