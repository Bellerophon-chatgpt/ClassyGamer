---
import BaseLayout from '../layouts/BaseLayout.astro';
import TextPage from '../components/TextPage.astro';
---

<BaseLayout title="Redactiestatuut">
  <TextPage
    eyebrow="Redactiestatuut"
    title="Onafhankelijk, en zo blijft het"
    intro="Hoe The Classy Gamer onafhankelijk blijft: wat wel en niet mag, en hoe ik daar open over ben."
  >
    <p class="cg-placeholder-note">Placeholder — de definitieve tekst van het redactiestatuut volgt.</p>
    <h2>1. Onafhankelijkheid</h2>
    <p>[Geen gesponsorde reviews; geen adverteerder heeft invloed op een oordeel.]</p>
    <h2>2. Hoe games verkregen worden</h2>
    <p>[Zelf gekocht of review-exemplaar — dit staat altijd bovenaan elke review.]</p>
    <h2>3. Affiliate-links en inkomsten</h2>
    <p>[Of en hoe er inkomsten zijn, en hoe dat gemeld wordt.]</p>
    <h2>4. Correcties en updates</h2>
    <p>[Hoe fouten worden hersteld en wanneer een review wordt bijgewerkt.]</p>
    <h2>5. Contact</h2>
    <p>[Hoe lezers en uitgevers contact opnemen.]</p>
  </TextPage>
</BaseLayout>
